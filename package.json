{
  "name": "archify",
  "private": true,
  "version": "0.1.0",
  "description": "Paseo 侧边栏插件「图鉴司」：接入 archify 技能包，把 JSON-IR 出成架构/工作流/时序/数据流/生命周期单体可交互 HTML，四门质检 + 台账 + HTTP 预览。要求 Paseo >= 0.10.3。",
  "license": "MIT",
  "keywords": [
    "paseo",
    "plugin",
    "archify",
    "diagram",
    "architecture",
    "visualization"
  ],
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "vendor/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.10.3",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
